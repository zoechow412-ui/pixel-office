{
  "name": "pixel-office",
  "version": "0.1.0",
  "description": "A pixel-art office for your Claude agents: hire AI employees, give them jobs, teach them things they never forget.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixel-office": "bin/pixel-office.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "locales",
    "templates",
    "catalog",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node bin/pixel-office.js",
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test-retry.mjs && node scripts/test-archive.mjs && node scripts/test-digest.mjs && node scripts/test-progress.mjs && node scripts/test-layout.mjs && node scripts/test-market.mjs && node scripts/test-integrations.mjs && node scripts/test-skills.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "flexsearch": "^0.8.212",
    "imapflow": "^2.9.0",
    "mailparser": "^3.12.2",
    "nodemailer": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "Basri Ayaz (https://github.com/basriayaz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basriayaz/pixel-office.git"
  },
  "homepage": "https://github.com/basriayaz/pixel-office#readme",
  "bugs": {
    "url": "https://github.com/basriayaz/pixel-office/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-sdk",
    "ai-agents",
    "pixel-art",
    "virtual-office",
    "anthropic"
  ]
}
